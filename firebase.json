{
  "hosting": {
    "public": "public",
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "routes.cjs"
    ],
    "redirects": [
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/admin.html", "destination": "/admin/", "type": 301 },
      { "source": "/teacher.html", "destination": "/teacher/", "type": 301 },
      { "source": "/student.html", "destination": "/student/", "type": 301 }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/admin/", "destination": "/admin.html" },
      { "source": "/teacher", "destination": "/teacher.html" },
      { "source": "/teacher/", "destination": "/teacher.html" },
      { "source": "/student", "destination": "/student.html" },
      { "source": "/student/", "destination": "/student.html" },

      { "source": "/admin/dashboard", "destination": "/admin/dashboard/index.html" },
      { "source": "/admin/dashboard/", "destination": "/admin/dashboard/index.html" },
      { "source": "/admin/teachers", "destination": "/admin/teachers/index.html" },
      { "source": "/admin/teachers/", "destination": "/admin/teachers/index.html" },
      { "source": "/admin/students", "destination": "/admin/students/index.html" },
      { "source": "/admin/students/", "destination": "/admin/students/index.html" },
      { "source": "/admin/approvals", "destination": "/admin/approvals/index.html" },
      { "source": "/admin/approvals/", "destination": "/admin/approvals/index.html" },
      { "source": "/admin/remarks", "destination": "/admin/remarks/index.html" },
      { "source": "/admin/remarks/", "destination": "/admin/remarks/index.html" },
      { "source": "/admin/exams", "destination": "/admin/exams/index.html" },
      { "source": "/admin/exams/", "destination": "/admin/exams/index.html" },
      { "source": "/admin/promotions", "destination": "/admin/promotions/index.html" },
      { "source": "/admin/promotions/", "destination": "/admin/promotions/index.html" },

      { "source": "/admin/finance/fees", "destination": "/admin/finance/fees/index.html" },
      { "source": "/admin/finance/fees/", "destination": "/admin/finance/fees/index.html" },
      { "source": "/admin/finance/payments", "destination": "/admin/finance/payments/index.html" },
      { "source": "/admin/finance/payments/", "destination": "/admin/finance/payments/index.html" },
      { "source": "/admin/finance/reports", "destination": "/admin/finance/reports/index.html" },
      { "source": "/admin/finance/reports/", "destination": "/admin/finance/reports/index.html" },
      { "source": "/admin/students/payment-status", "destination": "/admin/students/payment-status/index.html" },
      { "source": "/admin/students/payment-status/", "destination": "/admin/students/payment-status/index.html" },
      { "source": "/admin/students/access", "destination": "/admin/students/access/index.html" },
      { "source": "/admin/students/access/", "destination": "/admin/students/access/index.html" },
      { "source": "/admin/admissions/forms", "destination": "/admin/admissions/forms/index.html" },
      { "source": "/admin/admissions/forms/", "destination": "/admin/admissions/forms/index.html" },
      { "source": "/admin/admissions/applicants", "destination": "/admin/admissions/applicants/index.html" },
      { "source": "/admin/admissions/applicants/", "destination": "/admin/admissions/applicants/index.html" },
      { "source": "/admin/settings/portal-access", "destination": "/admin/settings/portal-access/index.html" },
      { "source": "/admin/settings/portal-access/", "destination": "/admin/settings/portal-access/index.html" },

      { "source": "/teacher/dashboard", "destination": "/teacher/dashboard/index.html" },
      { "source": "/teacher/dashboard/", "destination": "/teacher/dashboard/index.html" },
      { "source": "/teacher/gradebook", "destination": "/teacher/gradebook/index.html" },
      { "source": "/teacher/gradebook/", "destination": "/teacher/gradebook/index.html" },
      { "source": "/teacher/score-entry", "destination": "/teacher/score-entry/index.html" },
      { "source": "/teacher/score-entry/", "destination": "/teacher/score-entry/index.html" },
      { "source": "/teacher/assessments", "destination": "/teacher/assessments/index.html" },
      { "source": "/teacher/assessments/", "destination": "/teacher/assessments/index.html" },
      { "source": "/teacher/remarks", "destination": "/teacher/remarks/index.html" },
      { "source": "/teacher/remarks/", "destination": "/teacher/remarks/index.html" },

      { "source": "/student/dashboard", "destination": "/student/dashboard/index.html" },
      { "source": "/student/dashboard/", "destination": "/student/dashboard/index.html" },
      { "source": "/student/assessments", "destination": "/student/assessments/index.html" },
      { "source": "/student/assessments/", "destination": "/student/assessments/index.html" },
      { "source": "/student/profile", "destination": "/student/profile/index.html" },
      { "source": "/student/profile/", "destination": "/student/profile/index.html" },
      { "source": "/student/school-fees", "destination": "/student/school-fees/index.html" },
      { "source": "/student/school-fees/", "destination": "/student/school-fees/index.html" },
      { "source": "/student/payment-history", "destination": "/student/payment-history/index.html" },
      { "source": "/student/payment-history/", "destination": "/student/payment-history/index.html" },
      { "source": "/student/receipts", "destination": "/student/receipts/index.html" },
      { "source": "/student/receipts/", "destination": "/student/receipts/index.html" },
      { "source": "/student/financial-report", "destination": "/student/financial-report/index.html" },
      { "source": "/student/financial-report/", "destination": "/student/financial-report/index.html" },
      { "source": "/student/locked", "destination": "/student/locked/index.html" },
      { "source": "/student/locked/", "destination": "/student/locked/index.html" },

      { "source": "/form", "destination": "/form.html" },
      { "source": "/form/", "destination": "/form.html" },
      { "source": "/admission-form", "destination": "/admission-form/index.html" },
      { "source": "/admission-form/", "destination": "/admission-form/index.html" },
      { "source": "**", "destination": "/404.html" }
    ]
  }
}
